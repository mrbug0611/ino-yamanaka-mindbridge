DATABASE_URL=postgresql://postgres:PASSWORD_HERE@db:5432/mindbridge
POSTGRES_DB=mindbridge
POSTGRES_USER=USERNAME_HERE
POSTGRES_PASSWORD=PASSWORD_HERE


# default: try semantic, fallback to keyword
MINDBRIDGE_NLP_BACKEND=auto
#MINDBRIDGE_NLP_BACKEND=keyword   
# always keyword (e.g. for CI)
#MINDBRIDGE_NLP_BACKEND=semantic  
# fail hard if model unavailable

MINDBRIDGE_EMBED_MODEL=all-MiniLM-L6-v2
