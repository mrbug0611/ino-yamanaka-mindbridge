DATABASE_URL="postgresql://postgres:PASSWORD_HERE@localhost:5432/mindbridge"

MINDBRIDGE_NLP_BACKEND=auto# default: try semantic, fallback to keyword
#MINDBRIDGE_NLP_BACKEND=keyword   # always keyword (e.g. for CI)
#MINDBRIDGE_NLP_BACKEND=semantic  # fail hard if model unavailable

MINDBRIDGE_EMBED_MODEL=all-MiniLM-L6-v2# sentence-transformers for sentence embedding